{
  "version": 1,
  "runtime": "node",
  "commands": {
    "fast": "pnpm verify:fast",
    "full": "pnpm verify:full",
    "unit": "pnpm test:unit",
    "integration": "pnpm test:integration",
    "package": "pnpm test:package",
    "knip": "pnpm knip",
    "mutation": "pnpm test:mutation:domain"
  },
  "routing": [
    {
      "match": ["**/*"],
      "required": ["full"]
    },
    {
      "match": ["packages/core/**/*.ts"],
      "required": ["unit", "fast"],
      "recommended": ["mutation"]
    },
    {
      "match": [
        "packages/**/*.ts",
        "tests/**/*.ts",
        "*.config.*",
        "tools/**",
        "package.json",
        "pnpm*",
        "turbo.json",
        ".agents/**"
      ],
      "required": ["full"]
    }
  ]
}
