{
  "name": "difftrail-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node tools/audit-difficulty.mjs",
    "typecheck": "tsc --noEmit && pnpm --filter @difftrail/test-app typecheck",
    "test:unit": "vitest run",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts && node tools/test-example-history.mjs && node tools/test-affected-runner.mjs",
    "test:example-history": "pnpm build && node tools/test-example-history.mjs",
    "test:affected": "pnpm build && node tools/test-affected-runner.mjs",
    "knip": "knip",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit",
    "verify:full": "pnpm verify:fast && pnpm test:integration && pnpm test:package && pnpm knip",
    "test:mutation:domain": "stryker run",
    "test:package": "node tools/test-package.mjs"
  },
  "devDependencies": {
    "@barney-media/crap-typescript-vitest": "1.0.0",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11",
    "quality-metrics": "0.1.1"
  }
}
